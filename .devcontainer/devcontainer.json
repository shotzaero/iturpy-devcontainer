{
  "name": "ITU-Rpy Environment",
  "image": "python:3.10-bullseye",

  "postCreateCommand": "bash /tmp/setup-iturpy.sh",

  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/workspace/ITU-Rpy/venv/bin/python",
        "terminal.integrated.shell.linux": "/bin/bash"
      }
    }
  },

  "remoteUser": "root",

  "mounts": [
    "source=${localWorkspaceFolder}/.devcontainer/setup-iturpy.sh,target=/tmp/setup-iturpy.sh,type=bind"
  ]
}
